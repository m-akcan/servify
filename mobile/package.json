{
  "name": "@servify/mobile",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Servify for Android: sign in to your own Servify and watch and control your services.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
